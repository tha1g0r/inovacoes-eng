{
  "version": 1,
  "author": "Pedro",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "mic", "top": -90, "left": 180, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -70, "left": -120, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 30, "left": -130, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "mic:VCC", "esp:3V3", "red", [] ],
    [ "mic:GND", "esp:GND.1", "black", [] ],
    [ "mic:SIG", "esp:D34", "green", [] ],
    [ "led1:A", "r1:1", "red", [] ],
    [ "r1:2", "esp:D2", "red", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ]
  ]
}
